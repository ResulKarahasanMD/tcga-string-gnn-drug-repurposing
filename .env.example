# Copy to `.env` and fill in ONLY what you have. No credentials are invented or required
# for the default (open-source) pipeline. Do NOT commit `.env`.

# --- Optional: local DrugBank file (license-restricted; you must obtain it yourself) ---
# Academic license: https://go.drugbank.com/  (free for non-commercial academic use,
# approval required). If unset or missing, the pipeline uses the open DGIdb default.
DRUGBANK_XML=

# --- Optional: OncoKB API token (only if DISEASE_GENE_SOURCE=oncokb) ---
# Register at https://www.oncokb.org/  (academic/commercial terms apply).
ONCOKB_TOKEN=

# --- Optional: DisGeNET API key (only if DISEASE_GENE_SOURCE=disgenet) ---
# Register at https://www.disgenet.com/  (account required since 2023).
DISGENET_API_KEY=

# --- Polite identifier sent to the STRING API (fair-use / contact) ---
# STRING asks callers to identify themselves. Use your email or project URL.
STRING_CALLER_IDENTITY=repurpose-gnn.local
